# Copy to .env.local and fill in real values. Never commit .env.local.
# NEXT_PUBLIC_* vars are exposed to the browser; everything else is server-only.

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Sheets service account (Master Log sync) ────────────────────────
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Store \n literally in the key; the code restores real newlines.
GOOGLE_PRIVATE_KEY=

# ── Sync job auth ──────────────────────────────────────────────────────────
SYNC_SECRET=

# ── Contact form email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=

# ── Google Analytics 4 (public) ────────────────────────────────────────────
# GA4 measurement ID. Only loaded in production builds. Leave unset to disable.
NEXT_PUBLIC_GA_ID=G-397S5QF47H
